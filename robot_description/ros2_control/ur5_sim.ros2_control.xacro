<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="ur5_ros2_control_sim" params="prefix">
        <ros2_control name="${prefix}ur5_hw" type="system">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
            <xacro:macro name="ur5_joint" params="name">
                <joint name="${prefix}${name}">
                    <command_interface name="position"/>
                    <command_interface name="velocity"/>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                    <state_interface name="effort"/>
                </joint>
            </xacro:macro>
            <xacro:ur5_joint name="shoulder_pan_joint"/>
            <xacro:ur5_joint name="shoulder_lift_joint"/>
            <xacro:ur5_joint name="elbow_joint"/>
            <xacro:ur5_joint name="wrist_1_joint"/>
            <xacro:ur5_joint name="wrist_2_joint"/>
            <xacro:ur5_joint name="wrist_3_joint"/>
        </ros2_control>
    </xacro:macro>
</robot>