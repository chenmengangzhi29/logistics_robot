<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="ur5_ros2_control_sim" params="prefix">
        <ros2_control name="${prefix}ur5_hw" type="system">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
            <xacro:macro name="ur5_joint" params="name init_pos:=0.0">
                <joint name="${prefix}${name}">
                    <param name="initial_position">${init_pos}</param>
                    <command_interface name="position"/>
                    <command_interface name="velocity"/>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                    <state_interface name="effort"/>
                </joint>
            </xacro:macro>
            <xacro:ur5_joint name="shoulder_pan_joint"  init_pos="0.0"/>
            <xacro:ur5_joint name="shoulder_lift_joint" init_pos="-1.5708"/>
            <xacro:ur5_joint name="elbow_joint"         init_pos="1.5708"/>
            <xacro:ur5_joint name="wrist_1_joint"       init_pos="-1.5708"/>
            <xacro:ur5_joint name="wrist_2_joint"       init_pos="-1.5708"/>
            <xacro:ur5_joint name="wrist_3_joint"       init_pos="0.0"/>
        </ros2_control>
    </xacro:macro>
</robot>
