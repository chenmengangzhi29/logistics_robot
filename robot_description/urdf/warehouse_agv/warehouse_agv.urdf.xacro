<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="warehouse_agv">

    <xacro:property name="base_length" value="0.60"/>
    <xacro:property name="base_width" value="0.50"/>
    <xacro:property name="base_height" value="0.20"/>
    <xacro:property name="base_mass" value="30.0"/>
    <xacro:property name="wheel_radius" value="0.075"/>
    <xacro:property name="wheel_width" value="0.04"/>
    <xacro:property name="wheel_separation" value="0.42"/>
    <xacro:property name="wheel_x_offset" value="-0.017"/>  <!-- shift drive axle under combined base+UR5 CoM to stop idle creep -->

    <xacro:macro name="box_inertia" params="m x y z">
        <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
                 iyy="${m*(x*x+z*z)/12.0}" iyz="0"
                 izz="${m*(x*x+y*y)/12.0}"/>
    </xacro:macro>

    <xacro:macro name="warehouse_agv_robot" params="prefix">
        <link name="${prefix}base_footprint"/>
        <joint name="${prefix}base_footprint_to_base_link" type="fixed">
            <parent link="${prefix}base_footprint"/>
            <child link="${prefix}base_link"/>
            <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
        </joint>

        <link name="${prefix}base_link">
            <visual>
                <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
                <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
                <material name="agv_grey"><color rgba="0.4 0.4 0.45 1"/></material>
            </visual>
            <collision>
                <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
                <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
            </collision>
            <inertial>
                <!-- Lower the CoM to just above the wheel axle to keep the AGV stable in Gazebo -->
                <origin xyz="0 0 0.02" rpy="0 0 0"/>
                <mass value="${base_mass}"/>
                <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
            </inertial>
        </link>

        <!-- top mount plate, where the UR5 base bolts on-->
        <link name="${prefix}arm_mount_link"/>
        <joint name="${prefix}arm_mount_joint" type="fixed">
            <parent link="${prefix}base_link"/>
            <child link="${prefix}arm_mount_link"/>
            <origin xyz="-0.05 0 ${base_height + 0.05}" rpy="0 0 0"/>
        </joint>

        <!-- diff drive wheels -->
        <xacro:macro name="wheel" params="side y_reflect">
            <link name="${prefix}${side}_wheel_link">
                <visual>
                    <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                    <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                    <material name="wheel_black"><color rgba="0.1 0.1 0.1 1"/></material>
                </visual>
                <collision>
                    <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                    <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                </collision>
                <inertial>
                    <mass value="1.0"/>
                    <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
                </inertial>
            </link>
            <joint name="${prefix}${side}_wheel_joint" type="continuous">
                <parent link="${prefix}base_link"/>
                <child link="${prefix}${side}_wheel_link"/>
                <origin xyz="${wheel_x_offset} ${y_reflect * wheel_separation/2} 0" rpy="0 0 0"/>
                <axis xyz="0 1 0"/>
                <dynamics damping="1.0" friction="1.0"/>
            </joint>
        </xacro:macro>
        <xacro:wheel side="left" y_reflect="1"/>
        <xacro:wheel side="right" y_reflect="-1"/>

        <!-- caster (front and back) -->
        <xacro:macro name="caster" params="name x_offset">
            <link name="${prefix}${name}_caster_link">
                <visual><geometry><sphere radius="0.03"/></geometry></visual>
                <collision><geometry><sphere radius="0.03"/></geometry></collision>
                <inertial><mass value="0.1"/>
                    <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
            </link>
            <joint name="${prefix}${name}_caster_joint" type="fixed">
                <parent link="${prefix}base_link"/>
                <child link="${prefix}${name}_caster_link"/>
                <origin xyz="${x_offset} 0 ${-wheel_radius+0.03}" rpy="0 0 0"/>
            </joint>
        </xacro:macro>
        <xacro:caster name="front" x_offset="0.25"/>
        <xacro:caster name="back" x_offset="-0.25"/>

        <gazebo reference="${prefix}left_wheel_link">
            <mu1>500.0</mu1><mu2>500.0</mu2>
            <kp>1000000.0</kp><kd>10.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>0.1</maxVel>
            <fdir1>1 0 0</fdir1>
        </gazebo>
        <gazebo reference="${prefix}right_wheel_link">
            <mu1>500.0</mu1><mu2>500.0</mu2>
            <kp>1000000.0</kp><kd>10.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>0.1</maxVel>
            <fdir1>1 0 0</fdir1>
        </gazebo>
        <gazebo reference="${prefix}front_caster_link">
            <mu1>0.1</mu1><mu2>0.1</mu2>
            <kp>1000000.0</kp><kd>10.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>1.0</maxVel>
        </gazebo>
        <gazebo reference="${prefix}back_caster_link">
            <mu1>0.1</mu1><mu2>0.1</mu2>
            <kp>1000000.0</kp><kd>10.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>1.0</maxVel>
        </gazebo>

    </xacro:macro>
</robot>
                
