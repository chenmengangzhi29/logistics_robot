<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- UR5 link damping: prevents oscillation when stationary -->
    <xacro:macro name="ur5_gazebo_damping" params="prefix">
        <gazebo reference="${prefix}shoulder_link"><selfCollide>false</selfCollide></gazebo>
        <gazebo reference="${prefix}upper_arm_link"><selfCollide>false</selfCollide></gazebo>
        <gazebo reference="${prefix}forearm_link"><selfCollide>false</selfCollide></gazebo>
        <gazebo reference="${prefix}wrist_1_link"><selfCollide>false</selfCollide></gazebo>
        <gazebo reference="${prefix}wrist_2_link"><selfCollide>false</selfCollide></gazebo>
        <gazebo reference="${prefix}wrist_3_link"><selfCollide>false</selfCollide></gazebo>
    </xacro:macro>

    <xacro:ur5_gazebo_damping prefix="ur5_"/>
</robot>