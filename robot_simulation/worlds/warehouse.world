<?xml version="1.0"?>
<sdf version="1.6">
    <world name="warehouse">
        <include><uri>model://sun</uri></include>
        <include><uri>model://ground_plane</uri></include>

        <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"/>

        <model name="aruco_platform">
            <static>true</static>
            <pose>0.5 0.0 0.05 0 0 0</pose>

            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 0.8 0.10</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 0.8 0.10</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.4 0.4 0.4 1</ambient>
                        <diffuse>0.6 0.6 0.6 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <include>
            <uri>model://box_with_aruco_0</uri>
            <pose>0.5 0.0 0.15 0 0 0</pose>
        </include>
        <include>
            <uri>model://box_with_aruco_1</uri>
            <pose>0.5 0.2 0.15 0 0 0</pose>
        </include>
        <include>
            <uri>model://box_with_aruco_2</uri>
            <pose>0.5 -0.2 0.15 0 0 0</pose>
        </include>

        <physics type="ode">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
            <ode><solver>
                <type>quick</type>
                <iters>100</iters>
                <sor>1.3</sor>
            </solver></ode>
        </physics>
    </world>
</sdf>
